{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "role",
    "model",
    "effort",
    "owned_paths",
    "acceptance_evidence",
    "commands",
    "evidence_locations",
    "unresolved_risks",
    "stop_reason",
    "telemetry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"type": "string", "enum": ["COMPLETED", "PARTIAL", "FAILED"]},
    "role": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "effort": {"type": "string", "minLength": 1, "maxLength": 128},
    "owned_paths": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "acceptance_evidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1, "maxLength": 2000},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "UNVERIFIED"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
          "exit_code": {"type": "integer"}
        }
      }
    },
    "evidence_locations": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "unresolved_risks": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "stop_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "tool_calls",
        "retry_count",
        "duration_ms",
        "termination_reason"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "termination_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "COMPLETED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"commands": {"minItems": 1}}
      }
    }
  ]
}
