{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "role",
    "model",
    "effort",
    "phase_id",
    "implementer_thread_id",
    "base_revision",
    "result_revision",
    "owned_paths",
    "acceptance_evidence",
    "commands",
    "evidence_locations",
    "unresolved_risks",
    "stop_reason",
    "telemetry"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "status": {"type": "string", "enum": ["COMPLETED", "PARTIAL", "FAILED"]},
    "role": {"type": "string", "enum": ["manager_implementer"]},
    "model": {"type": "string", "enum": ["gpt-5.6-sol"]},
    "effort": {"type": "string", "enum": ["high"]},
    "phase_id": {"type": "string"},
    "implementer_thread_id": {"type": "string"},
    "base_revision": {"type": "string"},
    "result_revision": {"type": "string"},
    "owned_paths": {"type": "array", "items": {"type": "string"}},
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence"],
        "properties": {
          "criterion_id": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "UNVERIFIED"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code"],
        "properties": {
          "argv": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"}
        }
      }
    },
    "evidence_locations": {"type": "array", "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "stop_reason": {"type": "string"},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "tool_calls",
        "retry_count",
        "duration_ms",
        "termination_reason"
      ],
      "properties": {
        "input_tokens": {"type": "integer"},
        "cached_input_tokens": {"type": "integer"},
        "output_tokens": {"type": "integer"},
        "reasoning_output_tokens": {"type": "integer"},
        "tool_calls": {"type": "integer"},
        "retry_count": {"type": "integer"},
        "duration_ms": {"type": "integer"},
        "termination_reason": {"type": "string"}
      }
    }
  }
}
