{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "packets"],
  "properties": {
    "summary": {"type": "string"},
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "goal",
          "wave",
          "priority",
          "vertical_slice",
          "dependencies",
          "acceptance_criteria",
          "verification_hints"
        ],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "goal": {"type": "string"},
          "wave": {"type": "integer"},
          "priority": {"type": "integer"},
          "vertical_slice": {"type": "boolean"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "verification_hints": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
